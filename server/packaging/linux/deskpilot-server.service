# Headless mode (Raspberry Pi, media PCs):  systemctl --user enable --now deskpilot-server
# To keep it running without a login:       sudo loginctl enable-linger $USER
[Unit]
Description=DeskPilot Server (headless)
After=graphical-session.target network-online.target

[Service]
ExecStart=/opt/deskpilot-server/DeskPilotServer --headless
Restart=on-failure
RestartSec=3
Environment=DISPLAY=:0

[Install]
WantedBy=default.target
